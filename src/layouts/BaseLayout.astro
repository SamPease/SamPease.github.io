---
import RootMark from "../components/RootMark.astro";

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
  navLinks?: Array<{ href: string; label: string }>;
}

const {
  title,
  description = "Samantha Pease personal website",
  fullBleed = false,
  navLinks = [
    { href: "/project-writeups/", label: "Write-ups" },
    { href: "https://sampease.github.io/GSpinGGP/", label: "Dissertation Formalization" }
  ]
} = Astro.props;

const socialImage = new URL("/home/share.jpg", Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={socialImage} />
    <meta property="og:image:alt" content="Samantha Pease" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/bootstrap.min.css" />
    <link rel="stylesheet" href="/resume.min.css" />
    <slot name="head" />
    <style>
      :root {
        /* Palette, taken from the homepage photo: fleece blue, sunflower, grass. */
        --paper: #fcfbf8;
        --ink: #20242e;
        --muted: #616877;
        --line: #e7e2d8;
        --blue: #3c66a8;
        --sun: #eeaa22;
        --leaf: #5f8a4a;
        --rose: #d9705f;

        /* Older token names, still used by the write-up pages. */
        --deep-ink: #20242e;
        --panel: #ffffff;
        --border: #e7e2d8;
        --accent: #3c66a8;
        --accent-strong: #2f5590;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        /* resume.min.css adds sidebar padding (17rem on desktop) from the old theme. */
        padding: 0 !important;
        font-family: "Manrope", sans-serif;
        color: var(--ink);
        background: var(--paper);
        min-height: 100vh;
      }

      section[id] {
        scroll-margin-top: 24px;
      }

      .top-nav {
        max-width: 920px;
        margin: 0 auto;
        padding: 22px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .top-nav.wide,
      .site-footer.wide {
        max-width: 1120px;
      }

      .top-nav .home-link {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-right: auto;
        color: var(--ink);
        text-decoration: none;
        font: 600 1.15rem "Newsreader", serif;
      }

      .top-nav :global(.nav-mark) {
        width: 30px;
        height: 30px;
        flex: none;
      }

      .top-nav .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 4px 18px;
      }

      .top-nav .links a {
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
      }

      .top-nav .links a:hover {
        color: var(--ink);
      }

      .site-shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1rem 1.1rem 3.6rem;
      }

      :global(h1),
      :global(h2),
      :global(h3),
      :global(h4) {
        font-family: "Newsreader", serif;
        color: var(--ink);
        text-transform: none;
      }

      :global(h1) {
        font-size: clamp(2.1rem, 1.6rem + 1.8vw, 2.9rem);
        line-height: 1.15;
      }

      :global(h2) {
        font-size: clamp(1.7rem, 1.35rem + 1.2vw, 2.2rem);
        line-height: 1.2;
      }

      :global(h3) {
        font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
        line-height: 1.25;
      }

      :global(p),
      :global(li) {
        color: #2a303c;
        line-height: 1.68;
      }

      :global(a) {
        color: var(--accent);
      }

      .site-footer {
        max-width: 920px;
        margin: 48px auto 0;
        padding: 22px 20px 40px;
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 10px;
        font-size: 13px;
        color: var(--muted);
      }

      .site-footer :global(.footer-mark) {
        width: 18px;
        height: 18px;
      }

      .site-footer a {
        color: var(--muted);
      }

      @media (max-width: 720px) {
        .top-nav .home-link span {
          display: none;
        }

        .top-nav .links {
          gap: 4px 12px;
        }

        .top-nav .links a {
          font-size: 13px;
        }

        .site-shell {
          padding: 0.5rem 0.75rem 2.4rem;
        }
      }
    </style>
  </head>
  <body>
    <nav class:list={["top-nav", { wide: !fullBleed }]}>
      <a class="home-link" href="/" aria-label="Samantha Pease, home">
        <RootMark class="nav-mark" />
        <span>Samantha Pease</span>
      </a>
      <div class="links">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </nav>
    {
      fullBleed ? (
        <main>
          <slot />
        </main>
      ) : (
        <main class="site-shell">
          <slot />
        </main>
      )
    }
    <footer class:list={["site-footer", { wide: !fullBleed }]}>
      <RootMark class="footer-mark" />
      <span>© {new Date().getFullYear()} Samantha Pease · Built with <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a></span>
    </footer>
  </body>
</html>
