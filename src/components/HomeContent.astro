];

const rutgersTeaching = [
  { term: "2025–2026", role: "Tutor, Rutgers Tutoring Center" },
  { term: "2024–2025", role: "TA, large lecture of PreCalculus (MATH 114)" },
  { term: "2023–2024", role: "TA, large lecture of College Algebra (MATH 109)" },
  { term: "Summer 2023", role: "Applied Calculus (MATH 119)", href: "/Syllabus%20119.B1.doc" },
  { term: "Spring 2023", role: "TA, large lecture of College Algebra (MATH 109)" },
  { term: "Fall 2022", role: "TA, large lecture of Applied Calculus (MATH 119)" },
  { term: "Spring 2022", role: "Calculus 1 (MATH 135)", href: "/Calc%201%20Syllabus.doc" },
  { term: "Fall 2021", role: "TA, large lecture of PreCalculus (MATH 114)" },
  { term: "Summer 2021", role: "Applied Calculus (MATH 119)", href: "/Syllabus%20119.H6.doc" },
  { term: "2020–2021", role: "Tutor, Rutgers Tutoring Center" },
  { term: "2017–2020", role: "Tutor, Duke Math Help Room: linear algebra (applied and proof-based) and multivariable calculus" }
