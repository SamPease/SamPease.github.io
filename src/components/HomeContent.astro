const BLUEPRINT = "https://sampease.github.io/GSpinGGP/";
const DEP_GRAPH = "https://sampease.github.io/GSpinGGP/blueprint/dep_graph_document.html";

const contactLinks = [
  { href: "mailto:samantha.a.pease@gmail.com", label: "Email" },
  { href: "https://www.linkedin.com/in/sam-pease/", label: "LinkedIn", external: true },
  { href: "https://github.com/sampease", label: "GitHub", external: true },
  { href: "https://scholar.google.com/citations?user=ZUAvnNIAAAAJ&hl=en", label: "Google Scholar", external: true },
  { href: "https://x.com/SamPease24", label: "X / Twitter", external: true },
  { href: "/Samantha-Pease-CV.pdf", label: "CV", external: true }
];

const built = [
  {
    year: "2026",
    title: "BARSElo",
    href: "/project-writeups/barselo/",
    text: "Dodgeball player ratings that separate individual skill from the team you happened to play on."
  },
  {
    year: "2025",
    title: "Trans Advice Agent",
    href: "/project-writeups/trans-advice-agent/",
    text: "Question answering over community-sourced trans healthcare information, with sources for every answer."
  },
  {
    year: "2025",
    title: "Instagram Network Analysis",
    href: "/project-writeups/instagram-network/",
    text: "Communities and predicted connections in my mutual-follow graph.",
    thumb: "/home/thumb-instagram.png",
    alt: "My Instagram mutual-follow network, colored by community"
  },
  {
    year: "2023",
    title: "Neural network from scratch",
    href: "/Final%20Presentation.pptx",
    text: "CIFAR-10 cat vs. not-cat, and a lesson in architecture over brute-force tuning.",
    thumb: "/home/thumb-cats.png",
    alt: "CIFAR-10 images with the network's cat / not-cat predictions"
  },
  {
    year: "2017",
    title: "Wind turbine monitoring",
    href: "/Project%20info.pdf",
    text: "A remote monitoring prototype for WindAid in Peru. With Martin Cala.",
    thumb: "/home/thumb-turbine.jpg",
    alt: "A wind turbine built with WindAid in Trujillo, Peru"
  },
  {
    year: "2017",
    title: "Topology and forest canopies",
    href: "/Topology%20final%20project.pdf",
    text: "Persistent homology on LiDAR data. With Eva Arroyo and Nikita Zemlevskiy.",
    thumb: "/home/thumb-canopy.png",
    alt: "LiDAR canopy height map of a forest"
